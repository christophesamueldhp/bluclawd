{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"root": true,
	"plugins": ["./biome-plugins/raw-wait-for.grit", "./biome-plugins/loose-ok-result.grit"],
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"noImportCycles": "error"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": ["ext/**/*.ts", "daemon/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "daemon/remote/web/**/*.js"]
	}
}
