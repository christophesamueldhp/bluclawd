{
  "name": "bluclawd",
  "version": "0.0.1",
  "type": "module",
  "description": "The bluclawd feature layer as a pi package — install onto a stock pi with `pi install`.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./ext/permissions/index.ts",
      "./ext/hooks/index.ts",
      "./ext/model-controls/index.ts",
      "./ext/statusline/index.ts",
      "./ext/memory/index.ts",
      "./ext/checkpoints/index.ts",
      "./ext/subagents/index.ts",
      "./ext/web/index.ts",
      "./ext/mcp/index.ts",
      "./ext/sandbox/index.ts",
      "./ext/background-bash/index.ts",
      "./ext/branding/index.ts",
      "./ext/diagnostics/index.ts",
      "./ext/diff/index.ts",
      "./ext/fleet/index.ts",
      "./ext/skills/index.ts",
      "./ext/help/index.ts",
      "./ext/commands/index.ts",
      "./ext/history-search/index.ts"
    ],
    "skills": ["./skills"]
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "proper-lockfile": "4.1.2",
    "undici": "8.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@xterm/headless": "5.5.0",
    "chalk": "5.6.2",
    "typebox": "*",
    "typescript": "^5",
    "tsx": "^4",
    "vitest": "^4"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  }
}
