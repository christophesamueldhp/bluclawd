{
  "name": "bluclawd",
  "version": "0.0.1",
  "type": "module",
  "description": "The bluclawd feature layer as a pi package — install onto a stock pi with `pi install`.",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./ext/permissions/index.ts",
      "./ext/checkpoints/index.ts",
      "./ext/background-bash/index.ts",
      "./ext/branding/index.ts",
      "./ext/diagnostics/index.ts",
      "./ext/agent-view/index.ts",
      "./ext/help/index.ts",
      "./ext/vibes/index.ts",
      "./ext/paste/index.ts"
    ],
    "themes": ["./themes"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@silvia-odwyer/photon-node": "0.3.4",
    "typebox": "*",
    "typescript": "^5",
    "vitest": "^4"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  }
}
