diff --git a/test/sandbox/unix-socket-deny.test.ts b/test/sandbox/unix-socket-deny.test.ts
new file mode 100644
index 0000000..b194264
--- /dev/null
+++ b/test/sandbox/unix-socket-deny.test.ts
@@ -0,0 +1,170 @@
+// Added for bluclawd: a Unix-socket deny that wins over the Unix-socket
+// allows. See BLUCLAWD-NOTICE.txt.
+import { afterAll, afterEach, beforeAll, describe, expect, it } from 'bun:test'
+import { spawn } from 'node:child_process'
+import {
+  linkSync,
+  mkdirSync,
+  realpathSync,
+  rmSync,
+  symlinkSync,
+  writeFileSync,
+} from 'node:fs'
+import { connect, createServer, type Server } from 'node:net'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { SandboxManager } from '../../src/index.js'
+import type { SandboxRuntimeConfig } from '../../src/sandbox/sandbox-config.js'
+import { wrapCommandWithSandboxMacOS } from '../../src/sandbox/macos-sandbox-utils.js'
+import { isMacOS } from '../helpers/platform.js'
+
+// Prints CONNECTED, or the errno name the connect failed with.
+const CLIENT = [
+  'import errno, socket, sys',
+  's = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)',
+  'try:',
+  '    s.connect(sys.argv[1])',
+  "    print('CONNECTED')",
+  'except OSError as e:',
+  '    print(errno.errorcode.get(e.errno, e.errno))',
+].join('\n')
+
+function run(wrapped: string): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(wrapped, { shell: true })
+    let out = ''
+    child.stdout.on('data', chunk => (out += chunk))
+    child.on('error', reject)
+    child.on('close', () => resolve(out.trim()))
+  })
+}
+
+/** Whether a connect from outside the sandbox reaches the listener. */
+function connectsOutside(path: string): Promise<boolean> {
+  return new Promise(resolve => {
+    const socket = connect(path, () => {
+      socket.destroy()
+      resolve(true)
+    })
+    socket.on('error', () => resolve(false))
+  })
+}
+
+describe.if(isMacOS)('network.denyUnixSockets on macOS', () => {
+  // Spelled under tmpdir() (/tmp/...), whose real path is /private/tmp/...
+  const base = join(tmpdir(), `usd-${process.pid}`)
+  const denied = join(base, 'denied')
+  const other = join(base, 'other')
+  const deniedSocket = join(denied, 's.sock')
+  const otherSocket = join(other, 'o.sock')
+  const client = join(base, 'client.py')
+  const servers: Server[] = []
+
+  async function listen(path: string) {
+    const server = createServer(socket => socket.destroy())
+    servers.push(server)
+    await new Promise<void>(r => server.listen(path, () => r()))
+  }
+
+  beforeAll(async () => {
+    mkdirSync(denied, { recursive: true })
+    mkdirSync(other)
+    writeFileSync(client, CLIENT)
+    await listen(deniedSocket)
+    await listen(otherSocket)
+    // Made outside the sandbox, in a directory the deny does not name.
+    symlinkSync(deniedSocket, join(other, 'symlink.sock'))
+    linkSync(deniedSocket, join(other, 'hardlink.sock'))
+    symlinkSync(denied, join(base, 'denied-link'))
+  })
+
+  afterAll(() => {
+    for (const server of servers) server.close()
+    rmSync(base, { recursive: true, force: true })
+  })
+
+  afterEach(async () => {
+    await SandboxManager.reset()
+  })
+
+  async function connectInSandbox(
+    network: Partial<SandboxRuntimeConfig['network']>,
+    path: string,
+  ): Promise<string> {
+    await SandboxManager.initialize({
+      network: { allowedDomains: [], deniedDomains: [], ...network },
+      filesystem: { denyRead: [], allowWrite: [], denyWrite: [] },
+    })
+    const wrapped = await SandboxManager.wrapWithSandbox(
+      `python3 ${client} ${path}`,
+    )
+    const result = await run(wrapped)
+    expect(await connectsOutside(deniedSocket)).toBe(true)
+    return result
+  }
+
+  const allows: [string, Partial<SandboxRuntimeConfig['network']>][] = [
+    ['allowAllUnixSockets', { allowAllUnixSockets: true }],
+    ['an allowUnixSockets entry above it', { allowUnixSockets: [base] }],
+  ]
+  for (const [label, allow] of allows) {
+    describe(`with ${label}`, () => {
+      it('denies a socket in the directory', async () => {
+        expect(
+          await connectInSandbox(
+            { ...allow, denyUnixSockets: [denied] },
+            deniedSocket,
+          ),
+        ).toBe('EPERM')
+      })
+
+      it('denies it when the setting names the real path', async () => {
+        expect(
+          await connectInSandbox(
+            { ...allow, denyUnixSockets: [realpathSync(denied)] },
+            deniedSocket,
+          ),
+        ).toBe('EPERM')
+      })
+
+      for (const via of [
+        'other/symlink.sock',
+        'other/hardlink.sock',
+        'denied-link/s.sock',
+      ])
+        it(`denies it through ${via}`, async () => {
+          expect(
+            await connectInSandbox(
+              { ...allow, denyUnixSockets: [denied] },
+              join(base, via),
+            ),
+          ).toBe('EPERM')
+        })
+
+      it('still connects to an allowed socket elsewhere', async () => {
+        expect(
+          await connectInSandbox(
+            { ...allow, denyUnixSockets: [denied] },
+            otherSocket,
+          ),
+        ).toBe('CONNECTED')
+      })
+
+      it('connects to the socket without the setting', async () => {
+        expect(await connectInSandbox(allow, deniedSocket)).toBe('CONNECTED')
+      })
+    })
+  }
+
+  it('denies it when the network is not restricted', async () => {
+    const wrapped = wrapCommandWithSandboxMacOS({
+      command: `python3 ${client} ${deniedSocket}`,
+      needsNetworkRestriction: false,
+      denyUnixSockets: [denied],
+      readConfig: undefined,
+      writeConfig: undefined,
+    })
+    expect(await run(wrapped)).toBe('EPERM')
+    expect(await connectsOutside(deniedSocket)).toBe(true)
+  })
+})
