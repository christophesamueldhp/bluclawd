+// Added for bluclawd: the ask callback names the requesting command. See BLUCLAWD-NOTICE.txt.
+import { afterEach, beforeEach, describe, expect, it } from 'bun:test'
+import { connect, createServer, type AddressInfo, type Server } from 'net'
+import { randomUUID } from 'node:crypto'
+import { SandboxManager, type NetworkHostPattern } from '../../src/index.js'
+import {
+  encodeSandboxedCommand,
+  proxyUsernameFor,
+} from '../../src/sandbox/sandbox-utils.js'
+
+/** The status code the proxy answers a CONNECT to `target` under `username`. */
+function connectAs(
+  proxyPort: number,
+  target: string,
+  username: string,
+): Promise<number | undefined> {
+  return new Promise(resolve => {
+    const token = SandboxManager.getProxyAuthToken()
+    const auth = Buffer.from(`${username}:${token}`).toString('base64')
+    const socket = connect(proxyPort, '127.0.0.1', () => {
+      socket.write(
+        `CONNECT ${target} HTTP/1.1\r\nHost: ${target}\r\n` +
+          `Proxy-Authorization: Basic ${auth}\r\n\r\n`,
+      )
+    })
+    let data = ''
+    socket.on('data', chunk => {
+      data += chunk.toString()
+      if (data.includes('\r\n')) {
+        socket.destroy()
+        const status = data.match(/HTTP\/1\.\d (\d+)/)
+        resolve(status ? parseInt(status[1]) : undefined)
+      }
+    })
+    socket.on('error', () => resolve(undefined))
+    socket.setTimeout(2000, () => {
+      socket.destroy()
+      resolve(undefined)
+    })
+  })
+}
+
+describe('ask callback command id', () => {
+  let server: Server
+  let target: string
+  let asked: NetworkHostPattern[]
+
+  beforeEach(async () => {
+    await SandboxManager.reset()
+    server = createServer(socket => socket.on('error', () => {}))
+    await new Promise<void>(r => server.listen(0, '127.0.0.1', () => r()))
+    target = `127.0.0.1:${(server.address() as AddressInfo).port}`
+    asked = []
+    await SandboxManager.initialize(
+      {
+        network: { allowedDomains: [], deniedDomains: [] },
+        filesystem: { denyRead: [], allowWrite: [], denyWrite: [] },
+      },
+      async params => {
+        asked.push(params)
+        return false
+      },
+    )
+  })
+
+  afterEach(async () => {
+    await SandboxManager.reset()
+    server.close()
+  })
+
+  it('names the command whose proxy username asked', async () => {
+    const commandId = randomUUID()
+    const username = proxyUsernameFor(encodeSandboxedCommand(commandId))
+    expect(
+      await connectAs(SandboxManager.getProxyPort()!, target, username),
+    ).toBe(403)
+    expect(asked).toEqual([
+      { host: '127.0.0.1', port: Number(target.split(':')[1]), commandId },
+    ])
+  })
+
+  it('names no command for the bare username', async () => {
+    expect(await connectAs(SandboxManager.getProxyPort()!, target, 'srt')).toBe(
+      403,
+    )
+    expect(asked).toHaveLength(1)
+    expect(asked[0]!.commandId).toBeUndefined()
+  })
+})
