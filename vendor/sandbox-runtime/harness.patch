@@ -0,0 +1,135 @@
+import { createServer } from 'node:net'
+import { connect } from 'node:tls'
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { createMitmCA, disposeMitmCA } from '../../../dist/sandbox/mitm-ca.js'
+import { mintLeafCert } from '../../../dist/sandbox/mitm-leaf.js'
+import { serverTlsOn } from '../../../dist/sandbox/tls-terminate-proxy.js'
+
+const action = process.argv[2]
+if (!['end-soon', 'soon', 'after-finish', 'cut'].includes(action))
+  throw new Error('Invalid TLS lifecycle action')
+const SIZE = 32 << 20
+const caPath = fileURLToPath(new URL('./ca.crt', import.meta.url))
+const ca = createMitmCA({
+  caCertPath: caPath,
+  caKeyPath: fileURLToPath(new URL('./ca.key', import.meta.url)),
+})
+const leaf = mintLeafCert(ca, 'localhost')
+const owned = new Set()
+const timers = new Set()
+let handshake = false
+let actionPerformed = false
+let serverClosed = false
+let clientClosed = false
+let peerEnded = false
+let closedBeforePeerEnd = false
+let queuedBeforeAction = 0
+let read = 0
+let ended = false
+let client
+let succeed
+let fail
+const completion = new Promise((resolve, reject) => {
+  succeed = resolve
+  fail = reject
+})
+const complete = () => {
+  if (serverClosed && clientClosed) succeed()
+}
+const own = socket => {
+  owned.add(socket)
+  socket.once('close', () => owned.delete(socket))
+  return socket
+}
+const later = (fn, ms) => {
+  const timer = setTimeout(() => {
+    timers.delete(timer)
+    fn()
+  }, ms)
+  timers.add(timer)
+}
+const peerEnd = () => {
+  peerEnded = true
+  client.end()
+}
+const server = createServer({ allowHalfOpen: true }, socket => {
+  own(socket).on('error', () => {})
+  const { tls, outbound } = serverTlsOn(
+    socket,
+    Buffer.alloc(0),
+    { cert: leaf.certPem, key: leaf.keyPem },
+    () => {},
+  )
+  own(tls).on('error', () => {})
+  tls.once('close', () => {
+    serverClosed = true
+    closedBeforePeerEnd = !peerEnded
+    if (ended && !peerEnded) peerEnd()
+    complete()
+  })
+  tls.once('secure', () => {
+    handshake = true
+    const chunk = Buffer.alloc(64 << 10, 0x61)
+    for (let sent = 0; sent < SIZE; sent += chunk.length) tls.write(chunk)
+    queuedBeforeAction = Math.max(tls.writableLength, outbound.writableLength)
+    actionPerformed = true
+    if (action === 'end-soon') {
+      tls.end()
+      tls.destroySoon()
+    } else if (action === 'soon') tls.destroySoon()
+    else if (action === 'after-finish')
+      tls.end(() => setImmediate(() => tls.destroy()))
+    else tls.destroy()
+  })
+})
+let output
+try {
+  await new Promise((resolve, reject) => {
+    server.once('error', reject)
+    server.listen(0, '127.0.0.1', resolve)
+  })
+  client = own(
+    connect({
+      port: server.address().port,
+      host: '127.0.0.1',
+      allowHalfOpen: true,
+      servername: 'localhost',
+      ca: readFileSync(caPath),
+    }),
+  )
+  client.pause()
+  later(() => client.resume(), 300)
+  client.on('data', chunk => {
+    read += chunk.length
+    client.pause()
+    later(() => client.resume(), 5)
+  })
+  client.on('end', () => {
+    ended = true
+    if (action !== 'after-finish' || serverClosed) peerEnd()
+  })
+  client.on('error', () => {})
+  client.once('close', () => {
+    clientClosed = true
+    complete()
+  })
+  later(() => fail(new Error('TLS lifecycle did not settle')), 55000)
+  await completion
+  output = {
+    runtime: process.versions.bun ? 'bun' : 'node',
+    read,
+    ended,
+    handshake,
+    actionPerformed,
+    serverClosed,
+    closedBeforePeerEnd,
+    queuedBeforeAction,
+  }
+} finally {
+  for (const timer of timers) clearTimeout(timer)
+  for (const socket of owned) socket.destroy()
+  await new Promise(resolve => server.close(resolve))
+  await disposeMitmCA(ca)
+}
+console.log(JSON.stringify(output))
